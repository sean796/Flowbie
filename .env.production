# Production build env (for WP Engine). Copy to .env.production or set before `npm run build`.
# When building the frontend for WP Engine, set the Render API base URL so the app calls your backend.

VITE_MCP_API_BASE=https://your-api.onrender.com
# Optional: only if you host the server manager on Render
# VITE_SERVER_MANAGER_BASE=https://your-server-manager.onrender.com

# GSC: Set on the BACKEND (Render), not here. This file is for frontend build only.
# In Render dashboard → flowbie-api → Environment: add variable
#   GSC_SERVICE_ACCOUNT_JSON = entire service account JSON as one line (e.g. {"type":"service_account",...})
# Without this, GSC connect/scan will fail when using the app after deploying to WP Engine.
